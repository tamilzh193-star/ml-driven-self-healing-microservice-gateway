# =============================================================================
# Self-Healing Microservice Cloud Gateway - Local Environment Setup Template
# =============================================================================
# Copy this file to .env or export these variables in your deployment shell.
# NOTE: Never commit production credentials or production secrets to Git!

# --- Security & Administrative Authentication ---
# Enables strict X-Admin-Key validation on administrative and chaos injection endpoints
ADMIN_AUTH_ENABLED=true
# Replace this placeholder with a strong custom secret key in production
ADMIN_API_KEY=demo-admin-secret-change-me
ADMIN_KEY=demo-admin-secret-change-me

# --- Primary Relational Persistence (MySQL 8.0) ---
MYSQL_URL=jdbc:mysql://localhost:3306/self_healing_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_DRIVER=com.mysql.cj.jdbc.Driver
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
DB_PERSISTENCE_ENABLED=true

# --- Monitored Downstream Microservices ---
ORDER_SERVICE_URL=http://localhost:8081
PAYMENT_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083

# --- Machine Learning Service ---
ML_SERVICE_URL=http://localhost:5000
ML_SERVICE_ENABLED=true

# --- Autonomous Healing & Container Controls ---
DOCKER_CONTAINER_MODE=false
DOCKER_SOCKET_PATH=/var/run/docker.sock
HEALING_RESTART_MODE=auto
